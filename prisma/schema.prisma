// Prisma schema untuk Sinotaris
// Multi-tenant: semua data operasional terikat ke Office (kantor notaris)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // URL koneksi diatur di prisma.config.ts (format Prisma 7)
}

// ===== Tenant & Auth =====

model Office {
  id            String   @id @default(cuid())
  name          String // Nama kantor, mis. "Kantor Notaris & PPAT Budi, S.H., M.Kn."
  notarisName   String // Nama notaris pemilik
  notarisTitle  String? // Gelar, mis. "S.H., M.Kn."
  address       String?
  phone         String?
  wilayahKerja  String? // mis. "Provinsi Jawa Tengah"
  skNotarisNo   String? // Nomor SK pengangkatan
  skNotarisDate String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users                User[]
  subscriptions        Subscription[]
  clients              Client[]
  pekerjaan            Pekerjaan[]
  invoices             Invoice[]
  reminders            Reminder[]
  templates            DocTemplate[]
  archives             DocumentArchive[]
  auditLogs            AuditLog[]
  checklistTemplates   ChecklistTemplate[]
  checklistItems       PekerjaanChecklistItem[]
  checklistAttachments PekerjaanChecklistAttachment[]
  payments             Payment[]
  sequences            OfficeSequence[]
}

enum UserRole {
  NOTARIS // admin kantor: akses penuh termasuk biaya & tagihan
  STAF // akses terbatas, biaya/tagihan bisa disembunyikan
}

model User {
  id                     String                         @id @default(cuid())
  officeId               String
  office                 Office                         @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name                   String
  email                  String                         @unique
  passwordHash           String
  role                   UserRole                       @default(STAF)
  isActive               Boolean                        @default(true)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  generatedDocs          GeneratedDoc[]
  uploadedArchives       DocumentArchive[]              @relation("ArchiveUploadedBy")
  assignedPekerjaan      Pekerjaan[]                    @relation("PekerjaanPic")
  verifiedChecklistItems PekerjaanChecklistItem[]       @relation("ChecklistVerifiedBy")
  checklistAttachments   PekerjaanChecklistAttachment[] @relation("ChecklistAttachmentCreatedBy")
  createdInvoices        Invoice[]                      @relation("InvoiceCreatedBy")
  issuedInvoices         Invoice[]                      @relation("InvoiceIssuedBy")
  voidedInvoices         Invoice[]                      @relation("InvoiceVoidedBy")
  recordedPayments       Payment[]                      @relation("PaymentRecordedBy")
  voidedPayments         Payment[]                      @relation("PaymentVoidedBy")
}

enum AuditAction {
  CLIENT_CREATE
  CLIENT_UPDATE
  CLIENT_DELETE
  PEKERJAAN_CREATE
  PEKERJAAN_UPDATE
  PEKERJAAN_STATUS_CHANGE
  PEKERJAAN_WORKFLOW_UPDATE
  PEKERJAAN_DELETE
  ARCHIVE_UPLOAD
  ARCHIVE_REVIEW
  ARCHIVE_CONFIRM
  ARCHIVE_RELATION_UPDATE
  ARCHIVE_DELETE
  ARCHIVE_CANCEL_SCAN
  ARCHIVE_PREVIEW
  ARCHIVE_DOWNLOAD
  GENERATED_DOC_CREATE
  CHECKLIST_TEMPLATE_CREATE
  CHECKLIST_TEMPLATE_UPDATE
  CHECKLIST_TEMPLATE_DELETE
  CHECKLIST_APPLY
  CHECKLIST_ATTACHMENT_UPDATE
  CHECKLIST_STATUS_CHANGE
  REMINDER_CREATE
  REMINDER_STATUS_CHANGE
  REMINDER_DELETE
  INVOICE_CREATE
  INVOICE_UPDATE
  INVOICE_DELETE
  INVOICE_ISSUE
  INVOICE_VOID
  PAYMENT_CREATE
  PAYMENT_VOID
}

enum AuditTargetType {
  CLIENT
  PEKERJAAN
  DOCUMENT_ARCHIVE
  GENERATED_DOC
  CHECKLIST_TEMPLATE
  REMINDER
  INVOICE
  PAYMENT
}

model AuditLog {
  id         String          @id @default(cuid())
  officeId   String
  office     Office          @relation(fields: [officeId], references: [id], onDelete: Restrict)
  actorId    String?
  actorRole  String
  action     AuditAction
  targetType AuditTargetType
  targetId   String?
  metadata   Json
  createdAt  DateTime        @default(now())

  @@index([officeId, createdAt])
  @@index([officeId, action, createdAt])
  @@index([officeId, targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}

// ===== Subscription =====

enum SubscriptionPlan {
  TRIAL
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  EXPIRED // akses read-only
  CANCELED
}

model Subscription {
  id               String             @id @default(cuid())
  officeId         String
  office           Office             @relation(fields: [officeId], references: [id], onDelete: Cascade)
  plan             SubscriptionPlan   @default(TRIAL)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime // lewat tanggal ini + status bukan ACTIVE => read-only
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([officeId, status])
}

// ===== Klien =====

model Client {
  id           String     @id @default(cuid())
  officeId     String
  office       Office     @relation(fields: [officeId], references: [id], onDelete: Cascade)
  type         ClientType @default(PERORANGAN)
  name         String
  nik          String? // 16 digit, untuk perorangan
  nomorKk      String? // 16 digit, opsional dari Kartu Keluarga
  npwp         String?
  tempatLahir  String?
  tanggalLahir DateTime?
  gender       String? // Tuan / Nyonya / Nona
  pekerjaan    String?
  statusKawin  String?
  wargaNegara  String?    @default("Indonesia")
  address      String?
  phone        String?
  email        String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  pekerjaanList PekerjaanClient[]
  invoices      Invoice[]
  archives      DocumentArchive[]

  @@index([officeId, name])
}

enum ClientType {
  PERORANGAN
  BADAN_HUKUM
}

// ===== Pekerjaan (Akta / Legalisasi / Waarmerking) =====

enum PekerjaanKind {
  NOTARIS // Akta Notaris, Legalisasi, Waarmerking
  PPAT // AJB, APHT, SKMHT, Hibah, dll.
}

enum PekerjaanStatus {
  MASUK
  PROSES
  TANDA_TANGAN
  SELESAI
  DIBATALKAN
}

enum PekerjaanPriority {
  RENDAH
  NORMAL
  TINGGI
}

enum ChecklistItemStatus {
  KOSONG
  TERLAMPIR
  TERVERIFIKASI
  DITOLAK
  DILEWATI
}

model Pekerjaan {
  id            String            @id @default(cuid())
  officeId      String
  office        Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  kind          PekerjaanKind
  jenis         String // mis. "Akta Jual Beli", "SKMHT", "Legalisasi"
  nomorAkta     String?
  tanggalAkta   DateTime?
  judul         String // ringkasan, mis. "AJB - Budi Santoso ke Ani K"
  status        PekerjaanStatus   @default(MASUK)
  keterangan    String?
  picId         String?
  pic           User?             @relation("PekerjaanPic", fields: [picId], references: [id], onDelete: SetNull)
  dueDate       DateTime?         @db.Date
  priority      PekerjaanPriority @default(NORMAL)
  internalNotes String?           @db.Text
  completedAt   DateTime?

  // Data laporan PPAT (opsional, untuk laporan bulanan ATR/BPN)
  bentukHukum    String? // JB, HB, APHT, dst.
  pihakAlih      String?
  pihakTerima    String?
  luasTanah      Decimal? @db.Decimal(12, 2)
  luasBangunan   Decimal? @db.Decimal(12, 2)
  hargaTransaksi Decimal? @db.Decimal(18, 2)
  nop            String?

  // Pajak
  bphtb      Decimal?  @db.Decimal(18, 2)
  pphFinal   Decimal?  @db.Decimal(18, 2)
  sspTanggal DateTime?
  ssbTanggal DateTime?

  // Biaya kantor (hanya terlihat role NOTARIS)
  honorarium Decimal? @db.Decimal(18, 2)

  clients        PekerjaanClient[]
  invoices       Invoice[]
  documents      GeneratedDoc[]
  archives       DocumentArchive[]
  checklistItems PekerjaanChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([officeId, kind, status])
  @@index([officeId, tanggalAkta])
  @@index([officeId, status, dueDate])
  @@index([officeId, picId, status])
  @@index([officeId, priority, status])
}

model ChecklistTemplate {
  id        String                  @id @default(cuid())
  officeId  String
  office    Office                  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  kind      PekerjaanKind
  jenis     String
  jenisKey  String
  name      String
  isActive  Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  items     ChecklistTemplateItem[]

  @@unique([officeId, kind, jenisKey])
  @@index([officeId, isActive, kind])
}

model ChecklistTemplateItem {
  id           String                   @id @default(cuid())
  templateId   String
  template     ChecklistTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key          String
  label        String
  description  String?                  @db.Text
  required     Boolean                  @default(true)
  expectedType ArchiveDocumentType?
  sortOrder    Int                      @default(0)
  snapshots    PekerjaanChecklistItem[]

  @@unique([templateId, key])
  @@index([templateId, sortOrder])
}

model PekerjaanChecklistItem {
  id              String                         @id @default(cuid())
  officeId        String
  office          Office                         @relation(fields: [officeId], references: [id], onDelete: Cascade)
  pekerjaanId     String
  pekerjaan       Pekerjaan                      @relation(fields: [pekerjaanId], references: [id], onDelete: Cascade)
  templateItemId  String?
  templateItem    ChecklistTemplateItem?         @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  key             String
  label           String
  description     String?                        @db.Text
  required        Boolean                        @default(true)
  expectedType    ArchiveDocumentType?
  sortOrder       Int                            @default(0)
  status          ChecklistItemStatus            @default(KOSONG)
  rejectionReason String?                        @db.Text
  verifiedById    String?
  verifiedBy      User?                          @relation("ChecklistVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt      DateTime?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  attachments     PekerjaanChecklistAttachment[]

  @@unique([pekerjaanId, key])
  @@index([officeId, pekerjaanId, status])
  @@index([officeId, required, status])
}

model PekerjaanChecklistAttachment {
  id          String                 @id @default(cuid())
  officeId    String
  office      Office                 @relation(fields: [officeId], references: [id], onDelete: Cascade)
  itemId      String
  item        PekerjaanChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  archiveId   String
  archive     DocumentArchive        @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?                  @relation("ChecklistAttachmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())

  @@unique([itemId, archiveId])
  @@index([officeId, archiveId])
  @@index([itemId, createdAt])
}

// Relasi many-to-many klien <-> pekerjaan dengan peran
model PekerjaanClient {
  id          String    @id @default(cuid())
  pekerjaanId String
  pekerjaan   Pekerjaan @relation(fields: [pekerjaanId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  peran       String // mis. "Penjual", "Pembeli", "Pemberi Kuasa", "Debitor"

  @@unique([pekerjaanId, clientId, peran])
}

// ===== Invoice & Pembayaran =====

enum InvoiceStatus {
  DRAFT
  TERKIRIM
  LUNAS
  DIBATALKAN
  TERBIT
  VOID
}

enum InvoiceItemCategory {
  HONORARIUM
  BIAYA_PROSES
  TITIPAN_PAJAK
  TITIPAN_PNBP
  PAJAK_JASA
  LAINNYA
}

enum PaymentStatus {
  AKTIF
  VOID
}

enum PaymentMethod {
  TRANSFER
  TUNAI
  CEK_GIRO
  LAINNYA
}

model Invoice {
  id           String        @id @default(cuid())
  officeId     String
  office       Office        @relation(fields: [officeId], references: [id], onDelete: Restrict)
  number       String?
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  pekerjaanId  String?
  pekerjaan    Pekerjaan?    @relation(fields: [pekerjaanId], references: [id], onDelete: SetNull)
  status       InvoiceStatus @default(DRAFT)
  issuedAt     DateTime?
  dueDate      DateTime?     @db.Date
  notes        String?       @db.Text
  totalAmount  Decimal       @default(0) @db.Decimal(18, 2)
  totalPaid    Decimal       @default(0) @db.Decimal(18, 2)
  version      Int           @default(1)
  snapshotJson Json?
  createdById  String?
  createdBy    User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  issuedById   String?
  issuedBy     User?         @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  voidedById   String?
  voidedBy     User?         @relation("InvoiceVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidedAt     DateTime?
  voidReason   String?       @db.Text
  items        InvoiceItem[]
  payments     Payment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([officeId, number])
  @@index([officeId, status, dueDate])
  @@index([officeId, clientId])
  @@index([officeId, pekerjaanId])
}

model InvoiceItem {
  id        String              @id @default(cuid())
  invoiceId String
  invoice   Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  category  InvoiceItemCategory
  desc      String
  qty       Int                 @default(1)
  unitPrice Decimal             @db.Decimal(18, 2)
  lineTotal Decimal             @db.Decimal(18, 2)
  sortOrder Int                 @default(0)

  @@index([invoiceId, sortOrder])
}

model Payment {
  id            String        @id @default(cuid())
  officeId      String
  office        Office        @relation(fields: [officeId], references: [id], onDelete: Restrict)
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(18, 2)
  paidAt        DateTime
  recordedAt    DateTime      @default(now())
  method        PaymentMethod
  receiptNumber String
  requestKey    String
  reference     String?
  notes         String?       @db.Text
  recordedById  String?
  recordedBy    User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  status        PaymentStatus @default(AKTIF)
  voidedById    String?
  voidedBy      User?         @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidedAt      DateTime?
  voidReason    String?       @db.Text

  @@unique([officeId, receiptNumber])
  @@unique([officeId, requestKey])
  @@index([invoiceId, status])
  @@index([officeId, paidAt])
}

model OfficeSequence {
  officeId  String
  office    Office @relation(fields: [officeId], references: [id], onDelete: Restrict)
  key       String
  lastValue Int    @default(0)

  @@id([officeId, key])
}

// ===== Pengingat =====

enum ReminderType {
  LAPOR_WASIAT
  LAPOR_BULANAN
  PAJAK
  LAINNYA
}

model Reminder {
  id        String       @id @default(cuid())
  officeId  String
  office    Office       @relation(fields: [officeId], references: [id], onDelete: Cascade)
  type      ReminderType @default(LAINNYA)
  title     String
  dueDate   DateTime
  done      Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([officeId, done, dueDate])
}

// ===== Generator Dokumen =====

model DocTemplate {
  id         String         @id @default(cuid())
  officeId   String
  office     Office         @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name       String // mis. "SKMHT"
  fileName   String // nama file .docx di storage lokal (folder templates/)
  fieldsJson Json // definisi field form (diporting dari lib/fields.js)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  documents  GeneratedDoc[]
}

model GeneratedDoc {
  id               String           @id @default(cuid())
  templateId       String
  template         DocTemplate      @relation(fields: [templateId], references: [id])
  pekerjaanId      String?
  pekerjaan        Pekerjaan?       @relation(fields: [pekerjaanId], references: [id])
  archiveId        String?
  archive          DocumentArchive? @relation(fields: [archiveId], references: [id], onDelete: SetNull)
  generatedById    String?
  generatedBy      User?            @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  fileName         String
  dataJson         Json // snapshot data form saat generate
  templateChecksum String?
  archiveChecksum  String?
  outputChecksum   String?
  createdAt        DateTime         @default(now())
}

// ===== Pemindai & Arsip Dokumen =====

enum ArchiveDocumentType {
  KTP
  KARTU_KELUARGA
  NPWP
  SERTIPIKAT
  AKTA_PERJANJIAN
  UMUM
}

enum ArchiveStatus {
  PERLU_REVIEW
  DIKONFIRMASI
  GAGAL
}

model DocumentArchive {
  id                   String                         @id @default(cuid())
  officeId             String
  office               Office                         @relation(fields: [officeId], references: [id], onDelete: Cascade)
  clientId             String?
  client               Client?                        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  pekerjaanId          String?
  pekerjaan            Pekerjaan?                     @relation(fields: [pekerjaanId], references: [id], onDelete: SetNull)
  uploadedById         String?
  uploadedBy           User?                          @relation("ArchiveUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  type                 ArchiveDocumentType            @default(UMUM)
  status               ArchiveStatus                  @default(PERLU_REVIEW)
  originalName         String
  storageKey           String                         @unique
  mimeType             String
  sizeBytes            Int
  checksum             String
  rawText              String                         @default("")
  extractedJson        Json
  errorMessage         String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  generatedDocs        GeneratedDoc[]
  checklistAttachments PekerjaanChecklistAttachment[]

  @@index([officeId, status, createdAt])
  @@index([officeId, clientId])
  @@index([officeId, pekerjaanId])
}
