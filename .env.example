# Salin file ini ke .env lalu isi nilainya

# PostgreSQL lokal (contoh pakai Docker):
# docker run --name sinotaris-db -e POSTGRES_PASSWORD=sinotaris -e POSTGRES_DB=sinotaris -p 5432:5432 -d postgres:17
DATABASE_URL="postgresql://postgres:sinotaris@localhost:5432/sinotaris"

# Rahasia sesi NextAuth — generate dengan: npx auth secret
AUTH_SECRET=""

# Akun awal saat seed (opsional, ada default)
SEED_EMAIL="notaris@sinotaris.local"
SEED_PASSWORD="sinotaris123"

# Kalibrasi garis putus-putus dokumen (bawaan dari skmht-generator)
DASH_FILL_WIDTH=72
MAX_DASH_RUN=28
