# Public routing (not secrets)
PROXY_MODE=nginx
DOMAIN=sinotaris.reverse.my.id
ACME_EMAIL=admin@example.invalid
AUTH_URL=https://sinotaris.reverse.my.id
AUTH_TRUST_HOST=true

# PostgreSQL. Replace every placeholder; keep DATABASE_URL URL-encoded where needed.
POSTGRES_DB=REPLACE_WITH_DATABASE_NAME
POSTGRES_USER=REPLACE_WITH_DATABASE_USER
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://REPLACE_WITH_DATABASE_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/REPLACE_WITH_DATABASE_NAME

# Generate with: openssl rand -base64 48
AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_AUTH_SECRET

# Optional non-secret document rendering calibration.
DASH_FILL_WIDTH=72
MAX_DASH_RUN=28
